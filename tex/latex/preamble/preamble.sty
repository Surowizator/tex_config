\ProvidesPackage{preamble}

\RequirePackage{kvoptions}
\RequirePackage{etoolbox}
\SetupKeyvalOptions{
  family=preamble,
  prefix=preamble@
}
\DeclareStringOption[polish]{language}
\DeclareBoolOption[false]{notes}
\ProcessKeyvalOptions*

\input{languages.tex}
\input{packages.tex}
\input{environments.tex}
\input{looks.tex}
\input{referencing.tex}

\ifpreamble@notes
    \input{notes.tex}
\fi


\RequirePackage{common}
