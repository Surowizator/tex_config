\ProvidesPackage{common}

\newcommand\N{\ensuremath{\mathbb{N}}}
\newcommand\R{\ensuremath{\mathbb{R}}}
\newcommand\Z{\ensuremath{\mathbb{Z}}}
\renewcommand\O{\ensuremath{\emptyset}}
\newcommand\Q{\ensuremath{\mathbb{Q}}}
\newcommand\C{\ensuremath{\mathbb{C}}}

\newcommand{\niceop}[1]{\mathop{\mathrm{#1}}}
\newcommand{\ins}{\niceop{int}}
\newcommand{\charr}{\niceop{char}}

\newcommand{\D}[1]{\mathop{\mathrm{d}#1}}
\newcommand{\dv}[2]{\frac{\D{#1}}{\D{#2}}}
\newcommand{\pd}[2]{\frac{\partial{#1}}{\partial{#2}}}
\newcommand{\eval}[1]{\left. #1 \right\rvert}

\RequirePackage{stmaryrd} % for \lightning
% Add \contra symbol to denote contradiction
\newcommand\contra{\scalebox{1.5}{$\lightning$}}

% Stirling numbers
\newcommand{\cstir}[2]{\genfrac{\{}{\}}{0pt}{}{#1}{#2}}
\newcommand{\bstir}[2]{\genfrac{[}{]}{0pt}{}{#1}{#2}}
